# reply9842-server —— 隧道服务端的一键部署镜像
#
# 设计要点：
#   - 三阶段构建，最终 scratch 镜像（~12MB）。server 是纯 Go 静态二进制，
#     CGO_ENABLED=0，无 libc 依赖，scratch 足够。
#   - 非 root 运行（65532，与项目其他镜像一致）。
#   - 隧道监听 8443、健康检查监听 8080（都是非特权端口），证书通过 volume 挂载。
#   - 健康检查走 /healthz 路由 —— scratch 无 shell，不能 exec 型探活。

# ---- 构建 ----
FROM golang:1.27-alpine AS build
# tzdata：最终镜像是 scratch，要把 /usr/share/zoneinfo 拷进去，而 alpine 的
# golang 镜像并不自带它（2026-11-13 CI 实测 `/usr/share/zoneinfo: not found`）。
RUN apk add --no-cache tzdata
WORKDIR /src
# 依赖层单独缓存：源码变更不重编依赖
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
# TARGETOS / TARGETARCH 由 buildx 在多平台构建时自动注入（值即目标平台）。
# 必须显式传给 go build：不写 GOARCH 的话 go 用**构建机**的架构，于是
# `--platform linux/amd64,linux/arm64` 会产出一个架构错标的镜像。
# 2026-11-13 实测：在 arm64 Mac 上执行原来的 build 行（只有 GOOS=linux），
# 产物是 `ELF ... ARM aarch64`。单独 docker build（非 buildx）时这两个变量为空，
# GOARCH 留空即回退宿主架构，行为与改动前一致。
ARG TARGETOS
ARG TARGETARCH
# 架构自检不用 `file`：golang:1.27-alpine 里没有这个命令（2026-11-13 CI 实测
# exit 127，整个 server 镜像因此从未发布成功）。改用 Go 自己的构建信息断言，
# 它一定能读到目标二进制，且能把「cross 构建但架构错标」的回归挡住。
RUN set -eu; \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build \
      -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/reply9842-server ./cmd/server; \
    if [ -n "${TARGETARCH}" ]; then \
      go version -m /out/reply9842-server | grep -q "GOARCH=${TARGETARCH}"; \
    fi

# scratch 里没有 shell，不能建目录；状态目录必须在构建阶段就建好并交出属主。
# 否则运行期 os.UserHomeDir() 得到 "/"，stats 初始化会去 mkdir /.reply9842，
# 非 root（65532）直接 permission denied —— 2026-11-13 的镜像冒烟测试就是这么
# 挂的（`stats: mkdir /.reply9842: permission denied`）。
# 目录会作为 VOLUME 的种子：Docker 初始化匿名卷时连属主一起拷进去。
RUN mkdir -p /out/state/spool && chown -R 65532:65532 /out/state

# ---- 运行 ----
FROM scratch
COPY --from=build /out/reply9842-server /reply9842-server
# 时区数据（日志时间戳需要）
COPY --from=build /usr/share/zoneinfo /usr/share/zoneinfo
# 状态目录：预先建好并把属主交给运行用户（scratch 里没法 RUN chown）。
# HOME 指过去，server 的默认日志/统计就落在这个可写目录里，而不是 "/"。
COPY --from=build --chown=65532:65532 /out/state /var/lib/reply9842
ENV TZ=Asia/Shanghai \
    HOME=/var/lib/reply9842
# 证书与 spool 目录
VOLUME ["/certs", "/var/lib/reply9842"]
USER 65532:65532
# 8443 = 隧道（QUIC/TCP + TLS）；8080 = 健康检查（明文，仅内网）
EXPOSE 8443 8080
# scratch 无 shell、无 curl，用二进制自身的 --health-probe 模式探活
# （它 GET 自己的 /healthz，成功 exit 0，失败 exit 1）
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/reply9842-server", "--health-probe", "-health-addr", "127.0.0.1:8080"]
ENTRYPOINT ["/reply9842-server"]
# 默认参数：证书从 /certs 读，spool 落 volume
CMD ["-listen", "0.0.0.0:8443", \
     "-health-addr", "0.0.0.0:8080", \
     "-cert", "/certs/fullchain.pem", \
     "-key", "/certs/privkey.pem", \
     "-spool-dir", "/var/lib/reply9842/spool"]
